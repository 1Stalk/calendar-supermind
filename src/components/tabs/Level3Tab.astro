---
// src/components/tabs/Level3Tab.astro
---

<section class="tab-panel" id="tab-level-3">
  <div class="surface-card drill-card">
    <div class="drill-header">
      <h2 data-i18n="l3Title">Уровень 3: Мнемоника 12 месяцев</h2>
      <p data-i18n="l3Desc">Коды месяцев через ассоциации и блиц-проверка.</p>
      <div class="rhythmic-badge mono-nums" id="l3-rhythmic-banner" data-i18n="l3RhythmicTitle">
        Ритмический ключ: 033 · 614 · 625 · 035
      </div>
    </div>

    <!-- Переключатель подрежимов -->
    <div class="segmented-control">
      <button class="segment-btn active" id="btn-subtab-cards" data-i18n="l3TabCards">Карточки</button>
      <button class="segment-btn" id="btn-subtab-quiz" data-i18n="l3TabQuiz">Блиц-тест</button>
    </div>

    <!-- Режим 1: Карточки мнемоники -->
    <div id="l3-cards-view" class="cards-list">
      <!-- Генерируются в JS -->
    </div>

    <!-- Режим 2: Блиц-тест -->
    <div id="l3-quiz-view" style="display: none;">
      <div class="filter-toggle">
        <label class="toggle-label">
          <input type="checkbox" id="l3-leap-toggle" checked />
          <span data-i18n="l3LeapToggle">Учитывать високосные Янв/Фев</span>
        </label>
      </div>

      <div class="drill-box">
        <span class="drill-sublabel" data-i18n="l3PromptLabel">Код месяца:</span>
        <div class="drill-prompt-text" id="l3-prompt-display">Апрель</div>
        <div class="drill-hint-text" id="l3-mnemonic-hint" style="display: none;"></div>
      </div>

      <!-- Кнопки 0..6 -->
      <div class="options-grid-7" id="l3-buttons-grid">
        <!-- Генерируются в JS -->
      </div>

      <div class="feedback-box" id="l3-feedback"></div>
    </div>
  </div>
</section>

<style>
  .drill-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .drill-header h2 {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .drill-header p {
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .rhythmic-badge {
    margin-top: 6px;
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--accent);
    background-color: var(--accent-muted);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    letter-spacing: 0.05em;
  }

  /* Сегментный переключатель */
  .segmented-control {
    display: flex;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 3px;
    gap: 4px;
  }

  .segment-btn {
    flex: 1;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    transition: all 120ms ease;
  }

  .segment-btn.active {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }

  /* Сетка карточек мнемоники 2 колонки */
  :global(.cards-list) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    width: 100%;
  }

  :global(.m-card) {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  :global(.m-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
  }

  :global(.m-name) {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.m-code-badge) {
    font-size: 13px;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    background-color: var(--accent-muted);
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    flex-shrink: 0;
  }

  :global(.m-story) {
    font-size: 11.5px;
    color: var(--text-secondary);
    line-height: 1.35;
  }

  :global(.m-leap) {
    font-size: 10.5px;
    color: var(--warning);
    font-weight: 600;
    margin-top: 1px;
  }

  /* Блиц-тест */
  .filter-toggle {
    display: flex;
    justify-content: center;
  }

  .toggle-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-secondary);
    cursor: pointer;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  .drill-box {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 24px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
  }

  .drill-sublabel {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .drill-prompt-text {
    font-size: 24px;
    font-weight: 800;
    color: var(--accent);
  }

  .drill-hint-text {
    font-size: 12.5px;
    color: var(--warning);
    margin-top: 4px;
  }
</style>
