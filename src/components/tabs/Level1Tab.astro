---
// src/components/tabs/Level1Tab.astro
---

<section class="tab-panel" id="tab-level-1">
  <div class="surface-card drill-card">
    <div class="drill-header">
      <h2 data-i18n="l1Title">Уровень 1: Дни и цифры</h2>
      <p data-i18n="l1Desc">Мгновенный автоматизм: 1 = Пн ... 6 = Сб, 0 = Вс.</p>
    </div>

    <div class="drill-box">
      <span class="drill-sublabel" id="l1-mode-label" data-i18n="l1PromptLabel">Назовите цифру для дня:</span>
      <div class="drill-prompt-text" id="l1-prompt-display">Четверг</div>
    </div>

    <!-- 7 кнопок ответа под палец -->
    <div class="l1-grid" id="l1-buttons-grid">
      <!-- Генерируются динамически JS -->
    </div>

    <div class="feedback-box" id="l1-feedback"></div>
  </div>
</section>

<style>
  .drill-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .drill-header h2 {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .drill-header p {
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .drill-box {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 24px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .drill-sublabel {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .drill-prompt-text {
    font-size: 26px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  :global(.l1-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  :global(.l1-btn) {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 6px;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    transition: all 120ms ease;
  }

  :global(.l1-btn:last-child) {
    grid-column: span 2;
    flex-direction: row;
    gap: 8px;
  }

  :global(.l1-btn .btn-num) {
    font-size: 18px;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  :global(.l1-btn .btn-day-label) {
    font-size: 11.5px;
    color: var(--text-secondary);
  }

  :global(.l1-btn:hover) {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-muted);
  }

  :global(.l1-btn.correct) {
    background-color: var(--success-bg) !important;
    border-color: var(--success) !important;
    color: var(--success) !important;
  }
  :global(.l1-btn.correct .btn-day-label) {
    color: var(--success) !important;
  }

  :global(.l1-btn.wrong) {
    background-color: var(--danger-bg) !important;
    border-color: var(--danger) !important;
    color: var(--danger) !important;
  }
  :global(.l1-btn.wrong .btn-day-label) {
    color: var(--danger) !important;
  }
</style>
