---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import Header from '../components/Header.astro';
import StatsBar from '../components/StatsBar.astro';
import TabNavigation from '../components/TabNavigation.astro';

import SimulatorTab from '../components/tabs/SimulatorTab.astro';
import Level1Tab from '../components/tabs/Level1Tab.astro';
import Level2Tab from '../components/tabs/Level2Tab.astro';
import Level3Tab from '../components/tabs/Level3Tab.astro';
import Level4Tab from '../components/tabs/Level4Tab.astro';
import Level5Tab from '../components/tabs/Level5Tab.astro';

import CheatSheetModal from '../components/CheatSheetModal.astro';
---

<Layout>
  <div class="app-container">
    <Header />
    <StatsBar />
    <TabNavigation />

    <main class="main-content">
      <SimulatorTab />
      <Level1Tab />
      <Level2Tab />
      <Level3Tab />
      <Level4Tab />
      <Level5Tab />
    </main>

    <CheatSheetModal />
  </div>

  <script src="../scripts/app-controller.ts"></script>
</Layout>

<style>
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
