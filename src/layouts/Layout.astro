---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Календарный Сверхмозг | Тренажёр счёта дат в уме",
  description = "Интерактивный тренажёр для мгновенного определения дня недели любой даты в уме без калькулятора."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconUrl = `${base}/favicon.svg`;
const manifestUrl = `${base}/manifest.webmanifest`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#0f1217" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Сверхмозг" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={faviconUrl} />
  <link rel="manifest" href={manifestUrl} />
</head>
<body>
  <slot />
</body>
</html>
